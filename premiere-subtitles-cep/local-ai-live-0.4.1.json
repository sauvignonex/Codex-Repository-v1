    "status": "Предложено тем: 3. Проверь заголовки; текст речи и тайминги сохранены. Неудачные или слишком близкие предложения отфильтрованы.",
    "rows": [
      {
        "label": "1. 00:00:00,133 → 00:00:02,700",
        "text": "В традиционной бане — монча — обитали",
        "role": "speech"
      },
      {
        "label": "2. 00:00:02,700 → 00:00:05,433",
        "text": "духи-покровители: Монча-кува и Монча-кугыза.",
        "role": "speech"
      },
      {
        "label": "3. 00:00:05,433 → 00:00:07,100",
        "text": "Им оставляли воду и веник,",
        "role": "speech"
      },
      {
        "label": "4. 00:00:07,100 → 00:00:09,533",
        "text": "веря, что они хранят здоровье семьи.",
        "role": "speech"
      },
      {
        "label": "5. 00:00:09,533 → 00:00:11,133",
        "text": "Пихта — не просто дерево,",
        "role": "speech"
      },
      {
        "label": "6. 00:00:11,133 → 00:00:13,100",
        "text": "а священный оберег и целитель,",
        "role": "speech"
      },
      {
        "label": "7. 00:00:13,100 → 00:00:14,700",
        "text": "который изгоняет недуги.",
        "role": "speech"
      },
      {
        "label": "8. 00:00:14,700 → 00:00:16,900",
        "text": "«Шепот леса Мари» — это не просто",
        "role": "speech"
      },
      {
        "label": "9. 00:00:16,900 → 00:00:18,833",
        "text": "спа-процедура, а целостный ритуал,",
        "role": "speech"
      },
      {
        "label": "10. 00:00:18,833 → 00:00:20,233",
        "text": "где через тепло кедра,",
        "role": "speech"
      },
      {
        "label": "11. 00:00:20,233 → 00:00:22,533",
        "text": "силу ягод и аромат пихты человек",
        "role": "speech"
      },
      {
        "label": "12. 00:00:22,533 → 00:00:24,700",
        "text": "приобщается к древней мудрости народа,",
        "role": "speech"
      },
      {
        "label": "13. 00:00:24,700 → 00:00:26,700",
        "text": "который жил в гармонии с природой.",
        "role": "speech"
      },
      {
        "label": "14. 00:00:26,700 → 00:00:28,600",
        "text": "Процедура начинается с погружения",
        "role": "speech"
      },
      {
        "label": "15. 00:00:28,600 → 00:00:29,666",
        "text": "Кедровая\nБочка",
        "role": "title"
      },
      {
        "label": "16. 00:00:29,666 → 00:00:31,000",
        "text": "Это не просто прогрев,",
        "role": "speech"
      },
      {
        "label": "17. 00:00:31,000 → 00:00:33,433",
        "text": "а мощная фитотерапевтическая процедура:",
        "role": "speech"
      },
      {
        "label": "18. 00:00:33,433 → 00:00:35,600",
        "text": "вещества кедра отлично борются с",
        "role": "speech"
      },
      {
        "label": "19. 00:00:35,600 → 00:00:37,000",
        "text": "вирусами и бактериями.",
        "role": "speech"
      },
      {
        "label": "20. 00:00:37,000 → 00:00:39,400",
        "text": "Мягкое\nСкрабирование",
        "role": "title"
      },
      {
        "label": "21. 00:00:39,400 → 00:00:41,500",
        "text": "Этот этап — дань уважения марийской",
        "role": "speech"
      },
      {
        "label": "22. 00:00:41,500 → 00:00:43,600",
        "text": "традиции использовать «съедобные»",
        "role": "speech"
      },
      {
        "label": "23. 00:00:43,600 → 00:00:45,633",
        "text": "средства для ухода за кожей:",
        "role": "speech"
      },
      {
        "label": "24. 00:00:45,633 → 00:00:47,500",
        "text": "мёд — натуральный источник витаминов,",
        "role": "speech"
      },
      {
        "label": "25. 00:00:47,500 → 00:00:50,200",
        "text": "а брусника — лучшее средство для омоложения.",
        "role": "speech"
      },
      {
        "label": "26. 00:00:50,200 → 00:00:52,733",
        "text": "Завершающий и ключевой этап — это глубокий",
        "role": "speech"
      },
      {
        "label": "27. 00:00:52,733 → 00:00:55,200",
        "text": "Пихтовый\nМассаж",
        "role": "title"
      },
      {
        "label": "28. 00:00:55,200 → 00:00:58,200",
        "text": "которое марийцы издревле считали даром леса.",
        "role": "speech"
      },
      {
        "label": "29. 00:00:58,200 → 00:01:01,200",
        "text": "А после бани по традиции — чай с мёдом.",
        "role": "speech"
      }
    ]
  }
