[
  {
    "text": "В традиционной бане\n— монча — обитали",
    "fontSize": 55.00000000000001,
    "width": 573.539959716797,
    "height": 118.25000000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "духи-покровители:\nМонча-кува и Монча-кугыза.",
    "fontSize": 45.387994143484626,
    "width": 620,
    "height": 93.95314787701318,
    "scale": 0.22693997071742314,
    "valid": true,
    "reason": ""
  },
  {
    "text": "Им оставляли\nводу и веник,",
    "fontSize": 55.00000000000001,
    "width": 363.82500000000005,
    "height": 104.50000000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "веря, что они хранят\nздоровье семьи.",
    "fontSize": 55.00000000000001,
    "width": 550.9349731445313,
    "height": 103.67500000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "Пихта\n— не просто дерево,",
    "fontSize": 55.00000000000001,
    "width": 561.3850067138673,
    "height": 103.67500000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "а священный\nоберег и целитель,",
    "fontSize": 55.00000000000001,
    "width": 509.79501342773443,
    "height": 117.97500000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "который\nизгоняет недуги.",
    "fontSize": 55.00000000000001,
    "width": 445.55498657226565,
    "height": 118.25000000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "«Шепот леса Мари»\n— это не просто",
    "fontSize": 55.00000000000001,
    "width": 526.7899932861328,
    "height": 113.025,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "спа-процедура,\nа целостный ритуал,",
    "fontSize": 55.00000000000001,
    "width": 544.2799865722657,
    "height": 119.075,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "где через тепло кедра,",
    "fontSize": 55.00000000000001,
    "width": 609.4000000000001,
    "height": 37.675000000000004,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "силу ягод и\nаромат пихты человек",
    "fontSize": 55.00000000000001,
    "width": 593.3400268554688,
    "height": 104.50000000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "приобщается к древней\nмудрости народа,",
    "fontSize": 53.000510695917626,
    "width": 620,
    "height": 113.9510979962229,
    "scale": 0.2650025534795881,
    "valid": true,
    "reason": ""
  },
  {
    "text": "который жил в\nгармонии с природой.",
    "fontSize": 55.00000000000001,
    "width": 595.7049865722656,
    "height": 118.25000000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "Процедура начинается\nс погружения",
    "fontSize": 55.00000000000001,
    "width": 612.2599731445313,
    "height": 113.025,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "в кедровую бочку.",
    "fontSize": 55.00000000000001,
    "width": 495.05498657226565,
    "height": 52.800000000000004,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "Это\nне просто прогрев,",
    "fontSize": 55.00000000000001,
    "width": 518.4850067138673,
    "height": 103.95,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "а мощная фитотерапевтическая\nпроцедура:",
    "fontSize": 40.03874717468518,
    "width": 620,
    "height": 85.28253148207943,
    "scale": 0.2001937358734259,
    "valid": true,
    "reason": ""
  },
  {
    "text": "вещества кедра\nотлично борются",
    "fontSize": 55.00000000000001,
    "width": 460.7349731445313,
    "height": 117.97500000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "с вирусами\nи бактериями.",
    "fontSize": 55.00000000000001,
    "width": 378.675,
    "height": 117.97500000000001,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "После прогрева —\nмягкое скрабирование.",
    "fontSize": 54.1958041958042,
    "width": 620,
    "height": 116.25,
    "scale": 0.270979020979021,
    "valid": true,
    "reason": ""
  },
  {
    "text": "Этот этап — дань\nуважения марийской",
    "fontSize": 55.00000000000001,
    "width": 564.575,
    "height": 119.075,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "традиции использовать\n«съедобные»",
    "fontSize": 54.44805713409725,
    "width": 620,
    "height": 114.8854005529452,
    "scale": 0.27224028567048625,
    "valid": true,
    "reason": ""
  },
  {
    "text": "средства\nдля ухода за кожей:",
    "fontSize": 55.00000000000001,
    "width": 532.5650268554688,
    "height": 119.075,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "мёд — натуральный\nисточник витаминов,",
    "fontSize": 55.00000000000001,
    "width": 557.5900268554688,
    "height": 119.075,
    "scale": 0.275,
    "valid": true,
    "reason": ""
  },
  {
    "text": "а брусника — лучшее\nсредство для омоложения.",
    "fontSize": 47.13395077487363,
    "width": 620,
    "height": 101.80933367372705,
    "scale": 0.23566975387436817,
    "valid": true,
    "reason": ""
  },
  {
    "text": "Завершающий и ключевой\nэтап — это глубокий",
    "fontSize": 47.76579352850539,
    "width": 620,
    "height": 103.41294298921417,
    "scale": 0.23882896764252695,
    "valid": true,
    "reason": ""
  },
  {
    "text": "массаж с использованием\nпихтового масла,",
    "fontSize": 48.635078149702174,
    "width": 620,
    "height": 91.67712231218859,
    "scale": 0.24317539074851086,
    "valid": true,
    "reason": ""
  },
  {
    "text": "которое марийцы издревле\nсчитали даром леса.",
    "fontSize": 46.08295265370027,
    "width": 620,
    "height": 99.07834820545558,
    "scale": 0.23041476326850135,
    "valid": true,
    "reason": ""
  },
  {
    "text": "А после бани по\nтрадиции — чай с мёдом.",
    "fontSize": 50.275707472322836,
    "width": 620,
    "height": 108.0927710654941,
    "scale": 0.2513785373616142,
    "valid": true,
    "reason": ""
  }
]